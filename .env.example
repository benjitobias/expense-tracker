# Copy this to .env and fill in real credentials before running docker-compose up.
# .env is gitignored — never commit it.

# One account per person, comma-separated as username:password pairs.
# Each user gets their own private expenses/budgets and their own login.
USERS=alice:changeme,bob:changeme2
SECURE_COOKIES=true

# Legacy single-password installs: APP_PASSWORD is only read once, to create
# an "admin" account (or migrate existing data) on first boot after
# upgrading. Safe to remove from .env after that first boot. See README.
